# Copy to .env and adjust. All compose files read docker/.env.
# Host workflow: `docker compose -f docker/compose.db.yml up -d` then `cargo watch` + `npm run dev`.
POSTGRES_DB=alice
POSTGRES_USER=alice
POSTGRES_PASSWORD=alice
POSTGRES_PORT=5432
DATABASE_URL=postgres://alice:alice@127.0.0.1:5432/alice
ALICE_LISTEN_ADDR=0.0.0.0:8787
ALICE_PORT=8787
ALICE_CORS_ORIGIN=http://localhost:5173
ALICE_QUEUE_ENABLED=true
RUST_LOG=info
WEB_PORT=5173
PUBLIC_ALICE_API_URL=http://127.0.0.1:8787
