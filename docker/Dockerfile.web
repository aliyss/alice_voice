# syntax=docker/dockerfile:1.6
# Frontend web image. Handles both dev (npm run dev) and prod (npm run build) via target.
FROM node:20-bookworm-slim AS base
WORKDIR /app/frontend-web
COPY frontend-web/package.json frontend-web/package-lock.json ./
RUN npm ci

COPY frontend-web ./
EXPOSE 5173 3000
ENV PUBLIC_ALICE_API_URL=http://127.0.0.1:8787

# Dev stage: runs Vite SSR dev server with HMR.
FROM base AS dev
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]

# Prod build stage.
FROM base AS build
RUN npm run build

# Prod preview stage (optional).
FROM node:20-bookworm-slim AS runner
WORKDIR /app/frontend-web
COPY --from=build /app/frontend-web/dist ./dist
COPY --from=build /app/frontend-web/package.json ./package.json
COPY --from=build /app/frontend-web/node_modules ./node_modules
EXPOSE 3000
CMD ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "3000"]
