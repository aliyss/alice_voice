# Alice Voice Docker env - prefilled for dev.
# This file is read by `docker compose -f docker/compose.*.yml` (or with --env-file docker/.env).
# For host `cargo watch` and `npm run dev`, export these vars or use `set -a; source docker/.env`.

# Postgres (used by db service)
POSTGRES_DB=alice
POSTGRES_USER=alice
POSTGRES_PASSWORD=alice
POSTGRES_PORT=5434

# Backend - host will connect via 127.0.0.1, container via db:5432
DATABASE_URL=postgres://alice:alice@127.0.0.1:5434/alice
ALICE_LISTEN_ADDR=0.0.0.0:8788
ALICE_PORT=8788
ALICE_CORS_ORIGIN=http://localhost:5173
ALICE_QUEUE_ENABLED=true
RUST_LOG=info

# Frontend
WEB_PORT=5173
PUBLIC_ALICE_API_URL=http://127.0.0.1:8788

# Alt for reference when backend runs inside Docker (compose sets this automatically):
# DATABASE_URL_DOCKER=postgres://alice:alice@db:5432/alice
