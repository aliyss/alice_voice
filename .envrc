# Enter the development shell of shell.nix when entering this directory.
#
# The shell provides the accelerator libraries the built in models need.
# By default this file autodetects the hardware and enables the right
# flag, so `direnv allow` is enough:
#
#   Intel Arc / iGPU / NPU (Meteor Lake, this laptop) -> --arg gpu true  (OpenVINO)
#   NVIDIA                                   -> --arg cuda true (CUDA)
#   No GPU / CPU only                        -> no args
#
# Override with:
#
#   ALICE_GPU=true  direnv allow   # force Intel GPU (openvino)
#   ALICE_GPU=false direnv allow   # force CPU even if GPU is present
#   ALICE_CUDA=true direnv allow   # force CUDA (NVIDIA)
#   ALICE_CUDA=false direnv allow  # force off
#
# Manual shells still work:
#
#   nix-shell                         # CPU only
#   nix-shell --arg gpu true          # Intel GPU
#   nix-shell --arg cuda true         # NVIDIA
#   nix-shell --arg gpu true --arg cuda true
#
# Run `nix-shell --arg cuda false` for a shell without CUDA.

# --- autodetect (runs in direnv's bash, outside Nix) ---
_autodetect_gpu() {
  local has_intel=0 has_nvidia=0 has_amd=0 vendor
  if [ -d /sys/class/drm ]; then
    for f in /sys/class/drm/card*/device/vendor; do
      [ -f "$f" ] || continue
      vendor=$(cat "$f" 2>/dev/null || true)
      case "$vendor" in
        0x10de) has_nvidia=1 ;;
        0x8086) has_intel=1 ;;
        0x1002) has_amd=1 ;;
      esac
    done
  fi
  # nvidia driver files also indicate NVIDIA
  if [ -e /proc/driver/nvidia/version ] || [ -e /dev/nvidia0 ]; then
    has_nvidia=1
  fi
  # fallback via lspci when sysfs was not conclusive and lspci is available
  if [ "$has_intel" = 0 ] && [ "$has_nvidia" = 0 ] && [ "$has_amd" = 0 ] && command -v lspci >/dev/null 2>&1; then
    if lspci 2>/dev/null | grep -qi "nvidia"; then has_nvidia=1; fi
    if lspci 2>/dev/null | grep -Eqi "intel.*graphics|intel.*arc|meteor lake|arc graphics"; then has_intel=1; fi
    if lspci 2>/dev/null | grep -qi "amd.*graphics\|radeon"; then has_amd=1; fi
  fi
  # also consider render node as generic GPU hint
  if [ "$has_intel" = 0 ] && [ "$has_nvidia" = 0 ] && [ "$has_amd" = 0 ] && [ -e /dev/dri/renderD128 ]; then
    # unknown GPU, assume Intel/OpenVINO path (covers Meteor Lake without lspci)
    has_intel=1
  fi

  local gpu_arg=false cuda_arg=false
  if [ "$has_intel" = 1 ] || [ "$has_amd" = 1 ]; then gpu_arg=true; fi
  if [ "$has_nvidia" = 1 ]; then cuda_arg=true; fi

  # env overrides (ALICE_GPU / ALICE_CUDA take precedence, "0"/"false"/"off" = false)
  case "${ALICE_GPU:-}" in
    0|false|off|FALSE|OFF) gpu_arg=false ;;
    1|true|on|TRUE|ON) gpu_arg=true ;;
  esac
  case "${ALICE_CUDA:-}" in
    0|false|off|FALSE|OFF) cuda_arg=false ;;
    1|true|on|TRUE|ON) cuda_arg=true ;;
  esac

  # also respect legacy ALICE_GLINER_* set by a previous shell (no-op, just for docs)
  # export the decision for shell.nix's shellHook to echo
  # shellcheck disable=SC2034
  ALICE_AUTO_GPU=$gpu_arg
  # shellcheck disable=SC2034
  ALICE_AUTO_CUDA=$cuda_arg

  if [ "$gpu_arg" = true ] && [ "$cuda_arg" = true ]; then
    use nix --arg gpu true --arg cuda true
  elif [ "$gpu_arg" = true ]; then
    use nix --arg gpu true
  elif [ "$cuda_arg" = true ]; then
    use nix --arg cuda true
  else
    use nix
  fi
}

_autodetect_gpu
